# Supabase project URL, for example: https://YOUR_PROJECT.supabase.co
SUPABASE_URL=

# Supabase service-role key (server-only; never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Password used to enter /admin
ADMIN_PASSWORD=

# Long random secret used to sign the admin cookie
ADMIN_SECRET=
